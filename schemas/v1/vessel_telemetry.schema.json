{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://georisk-spark.example/schemas/v1/vessel-telemetry.schema.json",
  "title": "GeoRisk vessel telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_time", "vessel_id", "latitude", "longitude"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_time": {"type": "string", "format": "date-time"},
    "vessel_id": {"type": "string", "minLength": 1},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "speed_knots": {"type": "number", "minimum": 0},
    "heading_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}
  }
}
