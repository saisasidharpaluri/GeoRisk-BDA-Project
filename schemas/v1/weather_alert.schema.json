{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://georisk-spark.example/schemas/v1/weather-alert.schema.json",
  "title": "GeoRisk weather alert v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "alert_id", "event_time", "valid_from", "valid_until", "hazard_type", "severity", "geometry"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "alert_id": {"type": "string", "minLength": 1},
    "event_time": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "hazard_type": {"type": "string", "minLength": 1},
    "severity": {"type": "integer", "minimum": 1, "maximum": 5},
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"enum": ["Polygon", "MultiPolygon"]},
        "coordinates": {"type": "array", "minItems": 1}
      }
    }
  }
}
