{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://georisk-spark.example/schemas/v1/risk-event.schema.json",
  "title": "GeoRisk risk event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_time", "vessel_id", "h3_index", "h3_resolution", "risk_alert", "matching_hazards"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "coverage_mode": {"enum": ["center", "overlap"]},
    "event_time": {"type": "string", "format": "date-time"},
    "vessel_id": {"type": "string", "minLength": 1},
    "h3_index": {"type": "string", "minLength": 1},
    "h3_resolution": {"type": "integer", "minimum": 0, "maximum": 15},
    "risk_alert": {"type": "boolean"},
    "matching_hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alert_id", "severity"],
        "properties": {
          "alert_id": {"type": "string", "minLength": 1},
          "hazard_type": {"type": "string"},
          "severity": {"type": "integer", "minimum": 1, "maximum": 5},
          "valid_from": {"type": "string", "format": "date-time"},
          "valid_until": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
