# AWS configuration for later milestones. Never put access keys in this file.
AWS_REGION=us-east-1
GEORISK_RESOLUTION=7
GEORISK_DENSITY_WINDOW_MINUTES=15
GEORISK_INPUT_DIR=output/data
GEORISK_OUTPUT_DIR=output/processed
GEORISK_LAKE_DIR=output/lake
GEORISK_ATHENA_DATABASE=georisk
GEORISK_ATHENA_OUTPUT_S3=s3://replace-with-athena-query-results/
GEORISK_DASHBOARD_DATA_DIR=output
GEORISK_ROUTE_RISK_THRESHOLD=0.5
GEORISK_ROUTE_RISK_PENALTY=4.0
GEORISK_SEED=7
GEORISK_VESSEL_COUNT=10
GEORISK_TELEMETRY_POINTS=3
GEORISK_REPORT_PATH=output/reports/phase6-run.json
GEORISK_EVALUATION_FRACTION=0.2
GEORISK_ACCEPTANCE_REQUIRED=true
GEORISK_DEPLOYMENT_MODE=local
GEORISK_AWS_STACK_NAME=georisk-foundation
GEORISK_AWS_PROJECT_BUCKET_NAME=replace-with-globally-unique-bucket
GEORISK_AWS_GLUE_ROLE_ARN=arn:aws:iam::123456789012:role/replace-with-least-privilege-role
GEORISK_DEPLOYMENT_PLAN_PATH=output/reports/phase8-deployment-plan.json
GEORISK_FOUNDATION_TEMPLATE=infra/aws/georisk-foundation.template.json
S3_BUCKET=
KINESIS_TELEMETRY_STREAM=vessel-telemetry
KINESIS_HAZARD_STREAM=weather-alerts
